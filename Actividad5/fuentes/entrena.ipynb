   "source": [
    "## 13. Evidencia y reproducibilidad en MLflow\n",
    "Se consultan los runs registrados y se recarga el modelo desde el **Model Registry** por su alias, comprobando que predice exactamente igual que el modelo guardado en su run."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e845d30c",
   "metadata": {},
   "outputs": [],
   "source": [
    "runs = mlflow.search_runs([exp.experiment_id])\n",
    "cols = [\"tags.mlflow.runName\", \"tags.etapa\", \"tags.modelo\", \"metrics.cv_rmse\", \"metrics.test_rmse\", \"metrics.test_r2\", \"tags.git_commit\", \"tags.version_datos\"]\n",
    "display(runs[[c for c in cols if c in runs.columns]].query(\"`tags.etapa` != 'candidato'\").head(12))\n",
    "print(\"Total de runs (incluye candidatos del grid):\", len(runs))\n",
    "modelo_registrado = mlflow.sklearn.load_model(f\"models:/{train.NOMBRE_REGISTRO}@candidato\")\n",
    "df_l = pd.read_csv(dp.CSV_LIMPIO); X, y = dp.seleccionar_variables(df_l)\n",
    "ganador = res[\"seleccion\"][\"modelo\"]\n",
    "pred_reg = modelo_registrado.predict(X.head(5))\n",
    "pred_run = mlflow.sklearn.load_model(res[\"modelos\"][ganador][\"model_uri\"]).predict(X.head(5))\n",
    "print(\"Predicción del modelo registrado (MIRR/m²):\", np.round(pred_reg, 3))\n",
    "print(\"¿Idéntica a la del run?\", bool(np.allclose(pred_reg, pred_run, rtol=0, atol=1e-12)))"
   ]
  },
